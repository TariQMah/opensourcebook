# Settings for the scenes service (REFERENCE.md "Settings"). Names only; set them in your shell or in services/scenes/.env (git-ignored), never commit values.
SCENES_TOKEN=
SCENES_CONNECTOR_TOKEN=
# Optional
SCENES_PORT=
SCENES_CONNECTOR_URL=
SCENES_AGENT=
SCENES_AGENT_MODEL=
SCENES_AGENT_EFFORT=
SCENES_TURN_MINUTES=
SCENES_IDLE_MINUTES=
SCENES_DATA_DIR=
SCENES_ENGINE_URL=
SCENES_KEEP_JOBS=
SCENES_KEEP_DAYS=
SCENES_LIBRARY_DIR=
# Without ELEVENLABS_API_KEY videos are made without sound (captions carry the words). SCENES_VOICE=say is this computer's own robotic voice, for a quick test only.
# SCENES_VOICE=kokoro is a free voice that runs on this computer with no key, after `npm run voice:kokoro` once.
# The voice chosen in the app and its key are kept in a private file (0600) laid over these; left empty, voice.json in SCENES_DATA_DIR
SCENES_VOICE_FILE=
SCENES_VOICE=
ELEVENLABS_API_KEY=
SCENES_ELEVENLABS_VOICE=
SCENES_ELEVENLABS_MODEL=
# Speechify is the voice when SPEECHIFY_API_KEY is set and ELEVENLABS_API_KEY is not (free account: 333K-500K characters a month)
SPEECHIFY_API_KEY=
SCENES_SPEECHIFY_VOICE=
SCENES_SPEECHIFY_MODEL=
SCENES_SAY_VOICE=
SCENES_SAY_RATE=
SCENES_KOKORO_VOICE=
SCENES_KOKORO_SPEED=
OPENSOURCEBOOK_CHROME=
RENDER_CRF=
# Frames drawn at once: left empty, the service picks from this computer's cores and memory
RENDER_CONCURRENCY=
# Count fewer cores than there are, to see how a smaller computer draws
RENDER_CORES=
RENDER_SCALE=
# The toolbox (REFERENCE.md "The toolbox"): generated pictures, cut-outs and web search
META_API_KEY=
META_BASE_URL=
SI_API_KEY=
SCENES_YTDLP=
# off keeps the agent's own tools (shell, files, web) off even where the connector boxes them
SCENES_AGENT_WORKSPACE=
# index gives the video agent only the index of its skills at the start, not their pages whole (to compare)
SCENES_AGENT_KNOWLEDGE=
# The fresh viewer: a blind turn watches each finished video once and its maker gets one round on the notes; off (or 0) turns it off
SCENES_REVIEW=
# A model and effort for the fresh viewer's turn alone; left empty, the video's own
SCENES_REVIEW_MODEL=
SCENES_REVIEW_EFFORT=
# 1 keeps the agent's built-in prompt even on adapters that replace it on work turns (to compare)
SCENES_KEEP_AGENT_PROMPT=
